# Node modules
/ludo_client/node_modules/
/ludo_server/node_modules/

# Environment variables
/ludo_client/.env*
/ludo_server/.env*

# Build outputs
/ludo_client/build/
/ludo_client/dist/
/ludo_server/build/
/ludo_server/dist/
/ludo_client/web-build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React Native
/ludo_client/*.jsbundle
/ludo_client/*.jsc
/ludo_client/*.xcuserstate
/ludo_client/*.d.ts

# macOS
.DS_Store
/ludo_client/.DS_Store

# Windows
Thumbs.db
Desktop.ini

# IDEs and editor settings
.idea/
/.vscode/

# Temporary and debug files
*.tmp
*.swp
*.swo
/ludo_client/npm-debug.*
/ludo_client/yarn-debug.*
/ludo_client/yarn-error.*

# Expo
/ludo_client/.expo/
/ludo_client/expo-env.d.ts

# Native
/ludo_client/*.orig.*
/ludo_client/*.jks
/ludo_client/*.p8
/ludo_client/*.p12
/ludo_client/*.key
/ludo_client/*.mobileprovision

